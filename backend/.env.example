# Servidor
PORT=3001
NODE_ENV=development

# Base de datos (SQLite local; en producción cambiar a PostgreSQL)
DATABASE_URL="file:./dev.db"

# Seguridad / JWT
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_REFRESH_SECRET="cambia-este-refresh-secreto-en-produccion"
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
REMEMBER_REFRESH_TOKEN_DAYS=30

# Frontend (CORS)
CORS_ORIGIN="http://localhost:5173"

# Archivos adjuntos
UPLOAD_MAX_MB=10
UPLOAD_DIR="uploads"

# Contraseña del usuario MASTER inicial (solo usada por el seed)
SEED_ADMIN_PASSWORD="Admin123!"

# Configuración de correo (preparada para fase posterior; sin usar por ahora)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="helpdesk@example.com"
