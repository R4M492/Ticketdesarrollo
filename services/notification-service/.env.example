PORT=4006
NODE_ENV=development

# Secreto compartido para validar JWT emitidos por identity-service (ver packages/common/src/auth.ts).
JWT_SECRET="dev-shared-jwt-secret-change-me"

MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="notification_db"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Envío real de correo vía Gmail (opcional). Si se dejan vacías, el consumidor de "email.send"
# solo deja un log y no manda nada. SMTP_PASS es una "contraseña de aplicación" de 16 caracteres
# (requiere verificación en 2 pasos activada), se genera en https://myaccount.google.com/apppasswords
# — nunca la contraseña normal de la cuenta.
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Mantiene el fallo simulado (40% por intento) para poder demostrar reintentos/DLQ incluso con
# SMTP real configurado. Poner en "false" para que el envío real nunca falle a propósito.
SIMULATE_FAILURES="true"
